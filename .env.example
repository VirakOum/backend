DATABASE_URL=postgresql+psycopg://fastapi:fastapi@localhost:5432/fastapi_learning

# Public app config returned by GET /travel/app-config
GOOGLE_PLACES_API_KEY=

# Optional support config
SUPPORT_TELEGRAM_USERNAME=ride_support
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Optional safety config
SAFETY_POLICE_NUMBER=117
SAFETY_FIRE_NUMBER=118
SAFETY_AMBULANCE_NUMBER=119
SAFETY_COUNTRY_CODE=KH

# Optional payment and driver wallet config
ENABLE_DIGITAL_PAYMENT=false
DEFAULT_DRIVER_CASH_DEBT_LIMIT_USD=20
DEFAULT_DRIVER_CASH_DEBT_LIMIT_KHR=80000
AUTO_LOCK_DRIVER_ON_DEBT_LIMIT=true
